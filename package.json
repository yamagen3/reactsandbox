{
  "name": "react-sandbox",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "deploy": "npm run test:run && npm run build && git add -A && git diff-index --quiet HEAD || (git commit -m 'Deploy: Update build' && git push)"
  },
  "dependencies": {
    "@babel/standalone": "^7.23.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.2.0",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.2.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.8"
  }
}
